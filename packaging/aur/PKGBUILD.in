# Maintainer: Sorin Irimies <sorinirimies@gmail.com>
# Rendered by scripts/ci/distro.nu and pushed to the AUR as nuance-bin.
pkgname=nuance-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Themeable, git-aware Nushell prompt with a live-preview theme picker"
arch=('x86_64' 'aarch64')
url="https://github.com/sorinirimies/nuance"
license=('MIT')
depends=('nushell')
provides=('nuance')
conflicts=('nuance')
options=('!strip' '!debug')
source=("LICENSE-$pkgver::https://raw.githubusercontent.com/sorinirimies/nuance/v$pkgver/LICENSE")
source_x86_64=("nuance-x86_64-$pkgver.tar.gz::https://github.com/sorinirimies/nuance/releases/download/v$pkgver/nuance-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("nuance-aarch64-$pkgver.tar.gz::https://github.com/sorinirimies/nuance/releases/download/v$pkgver/nuance-aarch64-unknown-linux-musl.tar.gz")
sha256sums=('@SHA_LICENSE@')
sha256sums_x86_64=('@SHA_LINUX_X86@')
sha256sums_aarch64=('@SHA_LINUX_ARM@')

package() {
    install -Dm755 nuance "$pkgdir/usr/bin/nuance"
    install -Dm644 "LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    "$pkgdir/usr/bin/nuance" completions bash | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/nuance"
    "$pkgdir/usr/bin/nuance" completions zsh | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_nuance"
    "$pkgdir/usr/bin/nuance" completions fish | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/nuance.fish"
}

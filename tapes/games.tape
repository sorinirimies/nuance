# Game-inspired looks: Clair Obscur: Expedition 33, Super Mario, Fallout, Elden Ring, Zelda, DOOM, plus heist, farm sim, fighting game, roguelike, sandbox, cyberpunk.
Output docs/games.gif

Set Shell "nu"
Set FontFamily "FiraCode Nerd Font Mono"
Set FontSize 20
Set Width 1200
Set Height 1100
Set Padding 24
Set LineHeight 1.2
Set TypingSpeed 45ms

Hide
Type "$env.PROMPT_COMMAND = { || create_left_prompt }"
Enter
Type "$env.PROMPT_USER = 'sorin'"
Enter
Type "$env.PROMPT_HOST = 'nuance'"
Enter
Type "clear"
Enter
Sleep 300ms
Show

Sleep 600ms
Type "look expedition-33"
Enter
Sleep 1.6s
Type "look gommage"
Enter
Sleep 1.6s
Type "look mario-underground"
Enter
Sleep 1.6s
Type "look vault-111"
Enter
Sleep 1.6s
Type "look tarnished"
Enter
Sleep 1.6s
Type "^false"
Enter
Sleep 1.6s
Type "look phantom"
Enter
Sleep 1.6s
Type "look cavern"
Enter
Sleep 1.6s
Type "look test-chamber"
Enter
Sleep 1.6s
Type "look ember"
Enter
Sleep 1.6s
Type "look farmstead"
Enter
Sleep 1.6s
Type "look dojo"
Enter
Sleep 1.6s
Type "look underworld"
Enter
Sleep 1.6s
Type "look summit"
Enter
Sleep 1.6s
Type "look rain-noir"
Enter
Sleep 1.6s
Type "look blocky"
Enter
Sleep 1.6s
Type "look hyrule"
Enter
Sleep 1.6s
Type "look doom"
Enter
Sleep 1.6s
Type "look cyberpunk"
Enter
Sleep 1.6s
Sleep 1s

# Game-inspired looks: Clair Obscur: Expedition 33, Super Mario (underground), Fallout, Elden Ring, Zelda, DOOM, Cyberpunk.
Output docs/games.gif

Set Shell "nu"
Set FontFamily "FiraCode Nerd Font Mono"
Set FontSize 20
Set Width 1200
Set Height 900
Set Padding 24
Set LineHeight 1.2
Set TypingSpeed 45ms

Hide
Type "$env.PROMPT_COMMAND = { || create_left_prompt }"
Enter
Type "$env.PROMPT_USER = 'sorin'"
Enter
Type "$env.PROMPT_HOST = 'nuance'"
Enter
Type "clear"
Enter
Sleep 300ms
Show

Sleep 600ms
Type "look expedition-33"
Enter
Sleep 2s
Type "look gommage"
Enter
Sleep 2s
Type "look mario-underground"
Enter
Sleep 2s
Type "look vault-111"
Enter
Sleep 2s
Type "look tarnished"
Enter
Sleep 1.5s
Type "^false"
Enter
Sleep 2s
Type "look hyrule"
Enter
Sleep 2s
Type "look doom"
Enter
Sleep 2s
Type "look cyberpunk"
Enter
Sleep 2.4s
